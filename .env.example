# Enquiry form settings. Paste these into Netlify → Site configuration → Environment variables.
# Never commit real values: .env files are git-ignored. SMTP_PASS is a secret.
# Zoho Mail (India data centre, found from the neinsights.in MX records: mx.zoho.in).
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=operations@neinsights.in
# Zoho app-specific password (Zoho Mail → My Account → Security → App passwords). Production context only.
SMTP_PASS=
MAIL_TO=operations@neinsights.in
MAIL_FROM=operations@neinsights.in

# Optional
# Extra origins allowed to post the form (comma-separated), e.g. a staging domain.
ALLOWED_ORIGINS=
# Canonical domain used in canonical tags, the sitemap and social cards. Defaults to https://neinsights.in.
SITE_URL=
